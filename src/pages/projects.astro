---
import BaseLayout from '../layouts/BaseLayout.astro';

const projectIdeas = [
  {
    title: 'Personal Website',
    type: 'Live project',
    description:
      'The first project on this site is the site itself: a place to practice design, deployment, writing, and iteration.',
    status: 'In progress',
  },
  {
    title: 'React Experiments',
    type: 'Placeholder',
    description:
      'Small UI ideas, component patterns, state management tests, or frontend learning notes can be collected here.',
    status: 'Add later',
  },
  {
    title: 'Java Utilities',
    type: 'Placeholder',
    description:
      'Backend experiments, API sketches, command-line helpers, or service design notes can become short project logs.',
    status: 'Add later',
  },
];
---

<BaseLayout
  title="Projects | Amal Jacob"
  description="Projects and experiments by Amal Jacob."
  activePage="projects"
>
  <section class="page-hero" aria-labelledby="projects-title">
    <p class="eyebrow">Projects and experiments</p>
    <h1 id="projects-title">A growing archive of personal builds.</h1>
    <p class="lead compact">
      This page can start with placeholders and still be useful. Each entry gives you a
      future place to add context, screenshots, links, and notes without redesigning the
      whole site.
    </p>
  </section>

  <section class="project-list" aria-label="Project list">
    {
      projectIdeas.map((project) => (
        <article class="project-card">
          <div>
            <p class="card-label">{project.type}</p>
            <h2>{project.title}</h2>
            <p>{project.description}</p>
          </div>
          <span class="status-pill">{project.status}</span>
        </article>
      ))
    }
  </section>
</BaseLayout>
