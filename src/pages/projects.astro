---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (current, next) => current.data.order - next.data.order,
);
---

<BaseLayout
  title="Projects | Amal Jacob"
  description="Projects and experiments by Amal Jacob."
  activePage="projects"
>
  <section class="page-hero" aria-labelledby="projects-title">
    <p class="eyebrow">Projects and experiments</p>
    <h1 id="projects-title">A growing archive of personal builds.</h1>
    <p class="lead compact">
      This page can start with placeholders and still be useful. Each entry gives you a
      future place to add context, screenshots, links, and notes without redesigning the
      whole site.
    </p>
  </section>

  <section class="project-list" aria-label="Project list">
    {
      projects.map((project) => (
        <a class="project-card" href={`/projects/${project.id}/`}>
          <div>
            <p class="card-label">{project.data.type}</p>
            <h2>{project.data.title}</h2>
            <p>{project.data.summary}</p>
            <ul class="tag-list" aria-label={`${project.data.title} tags`}>
              {project.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>
          <span class="status-pill">{project.data.status}</span>
        </a>
      ))
    }
  </section>
</BaseLayout>
