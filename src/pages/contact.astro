---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Amal Jacob"
  description="Contact information for Amal Jacob."
  activePage="contact"
>
  <section class="page-hero narrow" aria-labelledby="contact-title">
    <p class="eyebrow">Contact</p>
    <h1 id="contact-title">Get in touch.</h1>
    <p class="lead compact">
      Have a question about a project or want to collaborate? Email is the best way to reach me.
    </p>
  </section>

  <section class="contact-panel" aria-label="Contact details">
    <div>
      <p class="card-label">Email</p>
      <h2>amaljacobs@gmail.com</h2>
    </div>
    <div class="actions">
      <a class="button primary" href="mailto:amaljacobs@gmail.com">Send email</a>
      <a class="button" href="https://github.com/amaljacobs">GitHub</a>
    </div>
  </section>
</BaseLayout>
