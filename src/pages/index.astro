---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout activePage="home">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">amal@portfolio:~$</p>
      <h1 id="hero-title">I build things<br />that are useful.</h1>
      <p class="lead">
        I’m Amal Jacob. Right now, I’m working on Meal Ledger, an Android app for tracking
        meals, water, and food spending.
      </p>
      <div class="actions" aria-label="Primary links">
        <a class="button primary" href="/projects/">View projects <span aria-hidden="true">→</span></a>
        <a class="button" href="/contact/">Get in touch</a>
      </div>
    </div>

    <div class="hero-side">
      <figure class="pixel-scene">
        <figcaption>workspace / late night build</figcaption>
        <img src="/pixel-desk-banner.png" alt="Pixel-art night workspace" />
      </figure>

      <aside class="status-card" aria-label="Current focus">
        <div class="window-bar"><span></span><span></span><span></span><p>now.txt</p></div>
        <ul class="status-list">
          <li><strong>01 / Building</strong><span>Meal Ledger</span></li>
          <li><strong>02 / Exploring</strong><span>Android, web apps, edge AI</span></li>
          <li><strong>03 / Elsewhere</strong><a href="https://github.com/amaljacobs">github.com/amaljacobs</a></li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section-grid" aria-label="Site overview">
    <article class="info-card">
      <p class="card-label">01 / ABOUT</p>
      <h2>How I work</h2>
      <p>Most projects start with a practical problem. I build a working version, test the idea, and improve it from there.</p>
    </article>

    <article class="info-card">
      <p class="card-label">02 / PROJECTS</p>
      <h2>What I make</h2>
      <p>Android, Flutter, and edge-AI projects. Some are active; others are experiments I learned from.</p>
    </article>

    <article class="info-card">
      <p class="card-label">03 / CONTACT</p>
      <h2>Let’s connect</h2>
      <p>Email me for project questions or collaboration. The source code is available on GitHub.</p>
    </article>
  </section>
</BaseLayout>
