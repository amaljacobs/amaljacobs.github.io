---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout activePage="home">
  <section class="hero" aria-labelledby="hero-title">
    <div>
      <p class="eyebrow">Developer portfolio</p>
      <h1 id="hero-title">Building useful software, one thoughtful project at a time.</h1>
      <p class="lead">
        I’m Amal Jacob, a developer interested in mobile apps, practical web experiences,
        and applied AI. I’m currently building Meal Ledger, a private Android journal for
        food, water, and food spending.
      </p>
      <div class="actions" aria-label="Primary links">
        <a class="button primary" href="/projects/">View projects</a>
        <a class="button" href="/contact/">Contact me</a>
      </div>
    </div>

    <aside class="status-card" aria-label="Current focus">
      <h2>Current Focus</h2>
      <ul class="status-list">
        <li>
          <strong>Now building</strong>
          <span>Meal Ledger: an offline-first Android journal for everyday food, water, and spending.</span>
        </li>
        <li>
          <strong>Interested in</strong>
          <span>Android development, practical product design, edge AI, and reliable data-driven apps.</span>
        </li>
        <li>
          <strong>Approach</strong>
          <span>Small, focused products that respect people’s time and keep the details clear.</span>
        </li>
      </ul>
    </aside>
  </section>

  <section class="section-grid" aria-label="Site overview">
    <article class="info-card">
      <p class="card-label">About</p>
      <h2>How I work</h2>
      <p>
        I enjoy taking an idea from a rough problem to a working product—then refining the
        experience until it feels straightforward to use.
      </p>
    </article>

    <article class="info-card">
      <p class="card-label">Projects</p>
      <h2>Selected projects</h2>
      <p>
        A growing collection of mobile, web, and edge-AI work, including active builds and
        earlier experiments that shaped how I approach products.
      </p>
    </article>

    <article class="info-card">
      <p class="card-label">Contact</p>
      <h2>Let’s connect</h2>
      <p>
        The easiest way to reach me is by email. You can also find the source behind these
        projects on GitHub.
      </p>
    </article>
  </section>
</BaseLayout>
