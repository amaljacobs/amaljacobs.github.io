---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout activePage="home">
  <section class="hero" aria-labelledby="hero-title">
    <div>
      <p class="eyebrow">Developer portfolio</p>
      <h1 id="hero-title">Mobile apps, web projects, and practical experiments.</h1>
      <p class="lead">
        I’m Amal Jacob. I’m currently building Meal Ledger, an Android app for tracking
        meals, water, and food spending.
      </p>
      <div class="actions" aria-label="Primary links">
        <a class="button primary" href="/projects/">View projects</a>
        <a class="button" href="/contact/">Contact me</a>
      </div>
    </div>

    <aside class="status-card" aria-label="Current focus">
      <h2>Current Focus</h2>
      <ul class="status-list">
        <li>
          <strong>Now building</strong>
          <span>Meal Ledger, an Android app for tracking food, water, and daily spending.</span>
        </li>
        <li>
          <strong>Interested in</strong>
          <span>Android development, web apps, and edge AI.</span>
        </li>
        <li>
          <strong>Approach</strong>
          <span>Start with a useful idea, get it working, then keep improving it.</span>
        </li>
      </ul>
    </aside>
  </section>

  <section class="section-grid" aria-label="Site overview">
    <article class="info-card">
      <p class="card-label">About</p>
      <h2>How I work</h2>
      <p>
        Most of my projects start with a practical problem. I build a working version,
        test the idea, and improve it as I go.
      </p>
    </article>

    <article class="info-card">
      <p class="card-label">Projects</p>
      <h2>Selected projects</h2>
      <p>
        A selection of Android, Flutter, and edge-AI projects—some active, some finished.
      </p>
    </article>

    <article class="info-card">
      <p class="card-label">Contact</p>
      <h2>Let’s connect</h2>
      <p>
        Reach me by email, or find the code behind these projects on GitHub.
      </p>
    </article>
  </section>
</BaseLayout>
